# next_sem("sp16")
# next_sem("su17")
#' Expand Semesters that Include ":" Inputs
#'
#' This function allows the use of `:` to refer to consecutive semesters. (e.g. FL23:SP25 to refer
#' to "Fall 2023", "Spring 2024", "Fall 2025", and "Spring 2025")
#'
#' @param ... Arguments that are either individual semesters or chunks of consecutive semesters in
#' the format `start:end`. Can be either strings or bare expressions, and accepts fairly flexible
#' semester formats (e.g., fl23, sp25) as long as they are unambiguous
#' @param type either "dw" (e.g., "Fall 2025") or "sis" (e.g., "FL2025") to control the output format
#' @param include_summer should summer semesters be included when expanding consecutive semesters?
#' `FALSE` by default since summer semesters are not of interest in most analyses
#'
#' @returns A character vector of semesters in the desired format
#' @export
sems_expand <- function(..., to_sis = FALSE, include_summer = FALSE) {
dots <- rlang::exprs(...)
sem_list <- purrr::map(dots, .f = \(x) {
if(!is.character(x)) x <- deparse1(x)
x <- x |>
stringr::str_split_1(pattern = ":") |>
sems_format(to_sis = to_sis)
if(is_scalar(x)) {
return(x)
}
c(start, end) %<-% x
sem <- start
# a character vector in which to build up with the sequential semesters
sems <- sem
while(TRUE) {
sem <- next_sem(sem, to_sis = to_sis, include_summer = include_summer)
print(sem)
sems <- c(sems, sem)
if(sem %is% end) {
break
}
}
return(sems)
})
return(purrr::list_c(sem_list))
}
sems_expand("sp16")
sems_expand("su17")
View(next_sem)
