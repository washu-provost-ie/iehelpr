compute_AY <- function(sem, prefix = "AY ") {
start <- compute_AY_startYear(sem)
end <- stringr::str_remove(start + 1, pattern = "^\\d\\d")
AY <- paste(start, end, sep = "-")
if(!is.null(prefix)) AY <- paste0(prefix, AY)
return(AY)
}
compute_AY(c("f24", "f26", "su20", NA))
compute_AY <- function(sem, prefix = "AY ") {
start <- compute_AY_startYear(sem)
is_na <- is.na(start)
end <- stringr::str_remove(start + 1, pattern = "^\\d\\d")
AY <- paste(start, end, sep = "-")
if(!is.null(prefix)) AY <- paste0(prefix, AY)
AY[is_na] <- NA
return(AY)
}
compute_AY(c("f24", "f26", "su20", NA))
