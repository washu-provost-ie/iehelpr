sems_expand <- function(..., to_sis = FALSE, include_summer = FALSE) {
dots <- rlang::exprs(...)
sems <- purrr::map(dots, .f = \(x) {
cat("\n")
if(!is.character(x)) x <- deparse1(x)
x <- x |>
stringr::str_split_1(pattern = ":") |>
sems_format(to_sis = to_sis)
if(is_scalar(x)) {
return(x)
}
c(start, end) %<-% x
print(glue::glue("start: {start}"))
print(glue::glue("end: {end}"))
sem <- start
# a character vector in which to build up with the sequential semesters
sems <- sem
while(TRUE) {
print(glue::glue("sems: {sems}"))
print(glue::glue("sem: {sem}"))
sem <- next_sem(sem, to_sis = to_sis, include_summer = include_summer)
print("next_sem: {.val sem}")
sems <- c(sems, sem)
if(sem %is% end) {
break
}
}
print("here")
return(sems)
}) |>
purrr::list_c(sems)
}
sems_expand("sp16", "f20:sp22")
